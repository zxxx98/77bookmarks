{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "77bookmarks-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "77bookmarks-sync",
      "migrations_dir": "migrations"
    }
  ],
  "secrets": { "required": ["SYNC_TOKEN"] }
}
