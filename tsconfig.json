{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node",
      "chrome"
    ]
  },
  "include": [
    "src",
    "shared",
    "server",
    "vite.config.ts",
    "extension/**/*.ts",
    "extension/lib.js"
  ]
}
