{
  "name": "77bookmarks",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8788",
    "build": "vite build && node scripts/package-extension.mjs",
    "build:extension": "npm run build",
    "preview": "vite preview --host 0.0.0.0 --port 8788",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:extension": "npm run build && node scripts/test-extension.mjs",
    "test:drag:extension": "npm run build && node scripts/test-drag-extension.mjs",
    "test:sync:extension": "npm run build && node scripts/test-sync-extension.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.71.0",
    "motion": "^14.11.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
