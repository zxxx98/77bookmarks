{
  "manifest_version": 3,
  "name": "77 Bookmarks",
  "description": "本地优先的新标签页书签桌面：多桌面、分组、待办与使用统计，可选云同步。",
  "version": "2.1.1",
  "minimum_chrome_version": "120",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "favicon",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "extension/popup.html",
    "default_title": "添加到 77 Bookmarks",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "add-page": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "添加当前网页到书签"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "options_page": "index.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'"
  }
}
